# =============================================
# Barangay Bantay - Environment Configuration
# =============================================
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# JWT Secret (change this in production!)
JWT_SECRET=your-super-secret-jwt-key-change-this

# =============================================
# Aiven PostgreSQL Configuration
# =============================================
# Get these values from your Aiven Console:
# 1. Go to https://console.aiven.io
# 2. Select your PostgreSQL service
# 3. Go to "Overview" tab
# 4. Copy the connection parameters

AIVEN_DB_USER=your_username
AIVEN_DB_PASSWORD=your_password
AIVEN_DB_HOST=your-host.aivencloud.com
AIVEN_DB_PORT=5432
AIVEN_DB_NAME=your_database_name

# CA Certificate from Aiven
# Download from Aiven Console > Service > Overview > Connection Information
# You can either:
# 1. Paste the certificate content directly (recommended for development)
# 2. Or use the file path: AIVEN_CA_CERT_PATH=./ca.pem
AIVEN_CA_CERT=-----BEGIN CERTIFICATE-----
your_certificate_content_here
-----END CERTIFICATE-----
